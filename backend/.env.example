# For local IDE run configuration only; never commit secrets
DB_URL=jdbc:postgresql://localhost:5432/luma
DB_USERNAME=luma_dev
DB_PASSWORD=local-only-change-me
SERVER_PORT=8080
# Access-token signing. Local development only: generate a throwaway key at startup.
LUMA_AUTH_EPHEMERAL_SIGNING_KEY=true
# Real environments instead inject a PKCS#8 RSA key from a secrets manager as
# LUMA_AUTH_SIGNING_KEY_PEM (never commit one) and set LUMA_AUTH_ISSUER to the public API origin.
# MFA: real environments also inject LUMA_AUTH_MFA_ENCRYPTION_KEY (Base64 of 32 random bytes) from a
# secrets manager. With the ephemeral flag above a throwaway key is used, so authenticators enrolled
# locally stop working after a backend restart (clear the account's row in account_totp to re-enrol).
# Zoom webhook ingress (off unless set). The secret token comes from the academy's Zoom app; never commit it.
# LUMA_ZOOM_WEBHOOK_SECRET_TOKEN=
# LUMA_ZOOM_WEBHOOK_ACADEMY_ID=
