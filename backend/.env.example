# For local IDE run configuration only; never commit secrets
DB_URL=jdbc:postgresql://localhost:5432/luma
DB_USERNAME=luma_dev
DB_PASSWORD=local-only-change-me
SERVER_PORT=8080
# Access-token signing. Local development only: generate a throwaway key at startup.
LUMA_AUTH_EPHEMERAL_SIGNING_KEY=true
# Real environments instead inject a PKCS#8 RSA key from a secrets manager as
# LUMA_AUTH_SIGNING_KEY_PEM (never commit one) and set LUMA_AUTH_ISSUER to the public API origin.
# MFA: real environments also inject LUMA_AUTH_MFA_ENCRYPTION_KEY (Base64 of 32 random bytes) from a
# secrets manager. With the ephemeral flag above a throwaway key is used, so authenticators enrolled
# locally stop working after a backend restart (clear the account's row in account_totp to re-enrol).
# Zoom webhook ingress (off unless set). The secret token comes from the academy's Zoom app; never commit it.
# LUMA_ZOOM_WEBHOOK_SECRET_TOKEN=
# LUMA_ZOOM_WEBHOOK_ACADEMY_ID=
# Email to account holders: invitation links and self-service password reset (off unless
# enabled). Any SMTP provider works; its credentials come from a secrets manager and are never
# committed. For local testing, a mail catcher such as Mailpit (SMTP on 1025) receives every message.
# LUMA_MAIL_ENABLED=true
# LUMA_MAIL_FROM=no-reply@academy.example
# LUMA_MAIL_WEB_ORIGIN=http://localhost:3000
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=1025
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# Per-visitor limits on the public auth routes (on by default). The visitor's address is taken
# from X-Forwarded-For only when the request comes from a trusted proxy: set LUMA_TRUSTED_PROXIES
# to a regular expression matching the Next.js servers and load balancers (default: this machine).
# LUMA_TRUSTED_PROXIES=10\.0\.\d{1,3}\.\d{1,3}
# LUMA_RATE_LIMIT_SIGN_IN_LIMIT=60          per 5 minutes (LUMA_RATE_LIMIT_SIGN_IN_WINDOW=PT5M)
# LUMA_RATE_LIMIT_MFA_LIMIT=60              per 5 minutes
# LUMA_RATE_LIMIT_LINK_REDEMPTION_LIMIT=30  per 10 minutes (activation and reset links)
# LUMA_RATE_LIMIT_RESET_REQUEST_LIMIT=10    per hour
