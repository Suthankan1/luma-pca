# Settings for scripts/zoom-test-tunnel.sh (a real Zoom test webinar on this Mac).
# Copy to .env.zoom-test (gitignored; easiest: run scripts/zoom-test-setup.sh, which asks for
# each value without showing it) and never commit, paste or share the real file.

# Zoom app (Marketplace > your Server-to-Server OAuth app > Features > Secret Token).
# Used now: verifies every webhook and answers Zoom's URL validation.
LUMA_ZOOM_WEBHOOK_SECRET_TOKEN=

# Required: only these test webinar IDs (digits, comma-separated) are stored. The event
# subscription covers the whole account, so events from real classes are dropped unread.
LUMA_ZOOM_WEBHOOK_WEBINAR_ALLOW_LIST=

# Zoom app (App Credentials page). Not used by LUMA yet: kept here for the API calls of 003A
# (webinar registrants and participant reports).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
