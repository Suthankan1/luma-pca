# LOCAL DEVELOPMENT ONLY; don't reuse these values in production
DB_NAME=luma
DB_USER=luma_dev
DB_PASSWORD=local-only-change-me
DB_PORT=5432

# --- Account email (invitations, password resets, attendance notices) ---------------------------------
# Set these in the backend's environment (on the server that runs the API), never in Git or the web app.
# Gmail: use a dedicated academy account with 2-Step Verification and a 16-character App password.
# LUMA_MAIL_ENABLED=true
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=sender@example.com
# SPRING_MAIL_PASSWORD=app-password-here
# LUMA_MAIL_FROM=sender@example.com
# LUMA_MAIL_WEB_ORIGIN=https://luma-pca.vercel.app
# LUMA_MAIL_STARTTLS_REQUIRED=true
# Stay under Gmail's daily sending limit when inviting many students:
# LUMA_MAIL_BULK_BATCH_SIZE=10
# LUMA_MAIL_BULK_POLL_INTERVAL=PT60S

# --- Academy's existing Supabase payments (backend ONLY; request a SELECT-only role) ---
# Keep disabled until the Academy approves the connection; never use its primary admin credential.
# LUMA_ACADEMY_PAYMENTS_ENABLED=true
# LUMA_ACADEMY_PAYMENTS_JDBC_URL=jdbc:postgresql://academy-pooler.example:5432/postgres?sslmode=require
# LUMA_ACADEMY_PAYMENTS_USERNAME=academy_readonly
# LUMA_ACADEMY_PAYMENTS_PASSWORD=provide-locally-not-in-git
# Supabase's pooler needs the role name followed by the project ref, e.g. luma_academy_readonly.<project-ref>.
# LUMA_ACADEMY_PAYMENTS_TABLE=public.payment
# LUMA_ACADEMY_STUDENT_TABLE=public.student
# LUMA_ACADEMY_CLASS_PAYMENT_TYPE=class
