# Server-side API and exact browser origin. Use HTTPS for the deployed frontend.
API_INTERNAL_URL=http://localhost:8080
LUMA_WEB_ORIGIN=http://localhost:3000
# Generate a separate key per environment: node -p 'require("node:crypto").randomBytes(32).toString("base64url")'
LUMA_SESSION_KEY=
# Number of trusted proxies (load balancer, CDN) in front of Next.js. The visitor's address is
# read from X-Forwarded-For only that many entries from the right and passed to the API for its
# per-visitor limits. Leave 0 when nothing sits in front (local development).
LUMA_TRUSTED_PROXY_HOPS=0
# Students sign in with their registration ID alone; set the same switch in the API. Read
# docs/security/STUDENT-ID-LOGIN.md before turning it on.
LUMA_STUDENT_ID_LOGIN_ENABLED=false
